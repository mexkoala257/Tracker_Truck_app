{
  "name": "fleet-tracker-display",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev:client": "vite dev --port 5000",
    "dev": "NODE_ENV=development tsx server/index-dev.ts",
    "dev:win": "tsx server/index-dev.ts",
    "build": "vite build && esbuild server/index-prod.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/index.js",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "db:ensure": "node scripts/ensure-schema.mjs",
    "pi:list": "tsx scripts/pi-deploy/deploy-pi.ts list",
    "pi:inspect": "tsx scripts/pi-deploy/deploy-pi.ts inspect",
    "pi:deploy": "tsx scripts/pi-deploy/deploy-pi.ts deploy",
    "pi:status": "tsx scripts/pi-deploy/deploy-pi.ts status",
    "pi:restart": "tsx scripts/pi-deploy/deploy-pi.ts restart",
    "pi:reboot": "tsx scripts/pi-deploy/deploy-pi.ts reboot",
    "pi:rollback": "tsx scripts/pi-deploy/deploy-pi.ts rollback",
    "pi:sync-tokens": "tsx scripts/pi-deploy/deploy-pi.ts sync-tokens"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.60.5",
    "@types/leaflet": "^1.9.21",
    "@types/pg": "^8.23.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "connect-pg-simple": "^10.0.0",
    "drizzle-orm": "^0.39.1",
    "drizzle-zod": "^0.7.0",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.545.0",
    "memorystore": "^1.6.7",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^2.1.0",
    "wouter": "^3.3.5",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.6",
    "ssh2": "^1.17.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.5",
    "typescript": "5.6.3",
    "vite": "^7.1.9"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  }
}
